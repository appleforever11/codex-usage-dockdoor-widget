[Unit]
Description=Codex Usage helper (local backend for the Codex Usage plasmoid)
Documentation=https://github.com/appleforever11/codex-usage-dockdoor-widget
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/libexec/codex-usage-helper daemon
Restart=on-failure
RestartSec=3
# Loopback-only daemon: it talks to the local Codex app-server and serves the
# plasmoid snapshot over 127.0.0.1.
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=default.target
